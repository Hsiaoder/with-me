{
  "name": "with-me",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 桌面宠物：整屏透明覆盖窗 + 可自定义皮肤 + 预渲染 webm 动画",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json && node tools/copy-static.mjs",
    "start": "npm run build && electron .",
    "e2e": "npm run build && node e2e/pet-check.mjs",
    "skin:test": "node tools/make-test-skin.mjs",
    "alpha:check": "node tools/alpha-report.mjs",
    "progress": "node tools/progress.mjs",
    "e2e:skin": "npm run build && node e2e/skin-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
